# Which PF data provider to use: "mock" | "aggregator"
PF_PROVIDER=mock

# Aggregator credentials (server-side only — never NEXT_PUBLIC_)
PF_PROVIDER_API_KEY=
PF_PROVIDER_BASE_URL=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the append-only consent log (JSON lines) is written.
# Defaults to ./data/consent-log.jsonl
CONSENT_LOG_PATH=
