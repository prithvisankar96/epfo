# Which PF data provider to use: "mock" | "aggregator"
PF_PROVIDER=mock

# Aggregator credentials (server-side only — never NEXT_PUBLIC_).
# Surepass bearer JWT from https://console.surepass.io (Settings → API Tokens).
PF_PROVIDER_API_KEY=
# Surepass sandbox: https://sandbox.surepass.io/api/v1
# Surepass production: https://kyc-api.surepass.app/api/v1
PF_PROVIDER_BASE_URL=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the append-only consent log (JSON lines) is written.
# Defaults to ./data/consent-log.jsonl
CONSENT_LOG_PATH=
